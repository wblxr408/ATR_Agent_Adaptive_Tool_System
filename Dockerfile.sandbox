FROM python:3.12-slim
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::https::Timeout=30 -o Acquire::Retries=2 update \
    && apt-get -o Acquire::https::Timeout=30 -o Acquire::Retries=2 install -y --no-install-recommends git ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir --timeout=30 --retries=2 pytest==8.4.2 \
    && mkdir -p /tool /workspace /out && chmod 1777 /out
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 65534:65534
WORKDIR /workspace
ENTRYPOINT ["python"]
