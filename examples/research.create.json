{
  "program": {
    "manifest": {
      "id": "project.research",
      "project_key": "repo:demo",
      "kind": "adapter",
      "adapter": "research",
      "description": "Retrieve current SQLite primary documentation with provenance",
      "side_effect": "read_only",
      "permissions": {
        "network": [
          "research"
        ]
      },
      "freshness_seconds": 0,
      "input_schema": {
        "type": "object",
        "properties": {
          "urls": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "urls"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": [
          "sources",
          "fact_status"
        ],
        "properties": {
          "fact_status": {
            "const": "unknown"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "url",
                "retrieved_at",
                "text",
                "fact_status"
              ]
            }
          }
        }
      },
      "checks": [
        {
          "inputs": {
            "urls": [
              "https://www.sqlite.org/fts5.html"
            ]
          },
          "expected_path": "fact_status",
          "expected": "unknown",
          "name": "provenance-does-not-claim-fact-verification"
        }
      ]
    }
  }
}
