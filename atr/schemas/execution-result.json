{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "type": {
          "default": "text/plain",
          "title": "Type",
          "type": "string"
        },
        "size_bytes": {
          "title": "Size Bytes",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "size_bytes",
        "name"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "Dependency": {
      "additionalProperties": false,
      "properties": {
        "tool_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$",
          "title": "Tool Id",
          "type": "string"
        },
        "version": {
          "pattern": "^v[1-9][0-9]*$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "tool_id",
        "version"
      ],
      "title": "Dependency",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "mode": {
      "enum": [
        "direct",
        "tool"
      ],
      "title": "Mode",
      "type": "string"
    },
    "tool_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Id"
    },
    "version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Version"
    },
    "status": {
      "enum": [
        "running",
        "succeeded",
        "failed",
        "timed_out",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exit Code"
    },
    "summary": {
      "default": "",
      "title": "Summary",
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "stdout_excerpt": {
      "default": "",
      "title": "Stdout Excerpt",
      "type": "string"
    },
    "validation_status": {
      "default": "unknown",
      "enum": [
        "passed",
        "failed",
        "unknown"
      ],
      "title": "Validation Status",
      "type": "string"
    },
    "duration_ms": {
      "default": 0,
      "title": "Duration Ms",
      "type": "integer"
    },
    "truncated": {
      "default": false,
      "title": "Truncated",
      "type": "boolean"
    },
    "candidate_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Id"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "suggested_fallback": {
      "anyOf": [
        {
          "$ref": "#/$defs/Dependency"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "run_id",
    "mode",
    "status"
  ],
  "title": "ExecutionResult",
  "type": "object"
}
