{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "tool_id": {
      "title": "Tool Id",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "checked_at": {
      "format": "date-time",
      "title": "Checked At",
      "type": "string"
    },
    "evidence": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Evidence",
      "type": "array"
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    },
    "fact_status": {
      "default": "unknown",
      "enum": [
        "unknown",
        "verified"
      ],
      "title": "Fact Status",
      "type": "string"
    },
    "environment": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Environment"
    }
  },
  "required": [
    "tool_id",
    "version",
    "passed",
    "checked_at"
  ],
  "title": "ReviewReport",
  "type": "object"
}
